# Скопіюй у .env і встав свої ключі. .env у .gitignore — у git він НЕ потрапляє.
# Після зміни .env перезапусти процес (Python читає env один раз на старті).

# Google AI Studio — https://aistudio.google.com  → Get API key (безкоштовний тариф)
GOOGLE_API_KEY=

# OpenAI — https://platform.openai.com/api-keys (потрібен баланс)
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys (потрібні кредити)
ANTHROPIC_API_KEY=
# Потрібен ТІЛЬКИ для корпоративних (identity-linked) ключів: без нього такий ключ
# повертає 400 «anthropic-workspace-id is required». Id видно в URL воркспейсу
# в Console: .../settings/workspaces/<оце значення>. Звичайним ключам не потрібен.
ANTHROPIC_WORKSPACE_ID=

# --- необов'язкові налаштування ---
# Пауза між викликами в прогоні тестсету, секунд (захист від 429 на free tier)
LLM_SLEEP_BETWEEN=4
# Базова затримка ретраю, секунд (1 → 2 → 4 → 8). Зменшуй тільки для швидких демо.
LLM_RETRY_BASE_DELAY=1
# Ретраїти навіть невідновлювані помилки (401/403). Потрібно лише для демо ретраю.
LLM_RETRY_ALL_ERRORS=0

# Groq — https://console.groq.com/keys (безкоштовно, без картки)
GROQ_API_KEY=
